{
  "name": "koder-cli",
  "version": "0.2.0",
  "description": "Koder CLI: review, change, test and run work in the terminal. The Koder kernel is not in this repository.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "koder": "bin/koder.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "bench": "node scripts/bench-startup.mjs",
    "bundle-kernel": "node scripts/bundle-kernel.mjs",
    "pack": "node scripts/pack.mjs"
  }
}
